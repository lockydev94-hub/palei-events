# ──────────────────────────────────────────────────────────────────
# Firebase configuration for the Palei Events project
# ──────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` (which is gitignored) and fill in the
# values. The values below are the project's real web SDK config —
# those are SAFE to commit (Firebase ships them in every client build).
# Only the Admin SDK private key is sensitive; keep that out of git.

# ── Public web SDK config (browser-safe, must start with NEXT_PUBLIC_) ──
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBu7QnHwFAjE2MEgyABxao4_WjisaqYbwI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=palei-events.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=palei-events
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=palei-events.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=833152934887
NEXT_PUBLIC_FIREBASE_APP_ID=1:833152934887:web:9b47daf5ba7b99a7031342
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ET4CNVZ4LN

# ── Admin SDK (server-only) ───────────────────────────────────────
# The Admin SDK is used by `npm run seed:admin` and any future Cloud
# Functions. NEVER commit the private key. Two options:
#
# Option A — point at the service-account JSON file (recommended for local dev):
#   GOOGLE_APPLICATION_CREDENTIALS=C:/MyWorkspace/palei-events/admin/palei-events-firebase-adminsdk-fbsvc-7ea2fb69f2.json
#
# Option B — inline the values (recommended for hosted deployments):
FIREBASE_ADMIN_PROJECT_ID=palei-events
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-fbsvc@palei-events.iam.gserviceaccount.com
# Leave the key blank in .env.example. Paste your private key in .env.local:
FIREBASE_ADMIN_PRIVATE_KEY=
